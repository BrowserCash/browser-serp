{
  "name": "@browsercash/serp",
  "version": "1.0.0",
  "description": "High-performance Google SERP API powered by Browser.cash",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/services/__tests__/*.test.ts src/routes/__tests__/*.test.ts",
    "test:live:smoke": "tsx scripts/serp-live-smoke.ts",
    "test:live:load": "tsx scripts/serp-live-load.ts"
  },
  "keywords": [
    "serp",
    "google",
    "search",
    "browser",
    "cdp"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/rate-limit": "^8.1.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.38.0",
    "fastify": "^4.28.1",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
