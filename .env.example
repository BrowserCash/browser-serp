BROWSER_CASH_API_KEY=put_browser_cash_api_key_here
# Required for LLM parsing (OpenRouter)
OPENROUTER_API_KEY=put_openrouter_key_here
# Optional override; defaults to https://api.browser.cash
# BROWSER_CASH_BASE=https://api.browser.cash
# Set true to write debug SERP HTML dumps
# SERP_DEBUG_HTML=false
# Set true for verbose LLM parser logging
# SERP_DEBUG_LOG=false
# Keep a single persistent Browser.cash session alive (reuse across requests)
# SERP_PERSISTENT_SESSION=false
PORT=8080
RATE_LIMIT_MAX=10
RATE_LIMIT_TIME_WINDOW=1 minute
ALLOWED_ORIGINS=*
LOG_LEVEL=info
