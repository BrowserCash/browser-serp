# Browser Cash API key (required)
# Compatibility alias: BROWSER_API_KEY also works
BROWSER_CASH_API_KEY=

# Legacy compatibility alias (optional)
# BROWSER_API_KEY=

# Primary pool target config.
# Example:
# BROWSER_POOL_TARGETS_JSON=[{"country":"US","type":"hosted","count":2}]
BROWSER_POOL_TARGETS_JSON=

# Fallback pool size when BROWSER_POOL_TARGETS_JSON is not set
SERP_POOL_SIZE=3

# Server configuration
PORT=8080
LOG_LEVEL=info
ALLOWED_ORIGINS=*
RATE_LIMIT_MAX=100

# SERP behavior
SERP_SEARCH_TIMEOUT_MS=12000
SERP_MAX_RETRIES=1
SERP_RECOVERY_ATTEMPTS=1
SERP_DEBUG_LOG=false
SERP_HEDGE_DELAY_MS=100
SERP_BATCH_CONCURRENCY=8
SERP_POOL_DEBUG=false

# Pool tuning
BROWSER_POOL_QUEUE_TIMEOUT_MS=60000
BROWSER_POOL_HEARTBEAT_MS=20000
BROWSER_POOL_SESSION_MAX_USES=25
BROWSER_POOL_SESSION_MAX_AGE_MS=600000
BROWSER_POOL_SESSION_DURATION_SEC=600
BROWSER_POOL_WINDOW_SIZE=1920x1080
BROWSER_POOL_TYPE_DEFAULT=consumer_distributed
BROWSER_POOL_ATTEMPT_TIMEOUT_MS=15000
BROWSER_POOL_MIN_HTML_LENGTH=256
BROWSER_POOL_MAX_DUPLICATE_NODE_RETRIES=4
BROWSER_POOL_PAGES_PER_BROWSER=4
BROWSER_POOL_RACE_WIDTH=3
