# Browser.cash API key (required)
# Get your API key from https://browser.cash
BROWSER_API_KEY=your_api_key_here

# Server configuration
PORT=8080
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS=*
LOG_LEVEL=info

# Pool configuration (for concurrent request handling)
SERP_POOL_SIZE=3
SERP_SESSION_MAX_USES=50
SERP_SESSION_MAX_AGE_MS=300000
SERP_MAX_RETRIES=2
SERP_HEALTH_CHECK_INTERVAL_MS=30000
SERP_SEARCH_TIMEOUT_MS=30000

# Debug options
SERP_DEBUG_HTML=false
SERP_DEBUG_LOG=false
